  "uv_metres": {
    "comment": "uv_repeat is repeats per metre, so one texture tile spans 1/uv_repeat metres. Set from a defensible feature where possible, otherwise recorded as an artistic approximation.",
    "plaster_wall": {
      "uv_repeat": 0.3,
      "basis": "artistic approximation; the plaster texture has no asserted physical scale in the catalogue"
    },
    "brick_wall": {
      "uv_repeat": 0.42,
      "basis": "approximation for a brick bond of roughly 0.2 x 0.06 m"
    },
    "clay_roof": {
      "uv_repeat": 0.18,
      "basis": "artistic approximation chosen so a terrace roof shows few whole repeats; courses then read near 0.3 m"
    },
    "timber": {
      "uv_repeat": 0.5,
      "basis": "approximation; board direction follows geometry UVs"
    },
    "setts_paving": {
      "uv_repeat": 0.85,
      "basis": "approximation: ~1.2 m per texture tile so setts read at roughly 7-10 cm, not as rubble"
    }
  },
